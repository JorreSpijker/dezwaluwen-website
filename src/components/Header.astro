---
import { linkHref, menu } from '../data/menu';
import MobileMenu from './MobileMenu.astro';
---

<header class="header" data-header>
  <div class="bar container">
    <a href="/" class="logo" aria-label="KV de Zwaluwen, naar home">
      <span class="logo-cover"></span>
      <img src="/logo.svg" alt="" width="104" height="108" />
    </a>

    <nav class="nav" aria-label="Hoofdmenu">
      {
        menu.map((item, i) => (
          <button class="nav-item" type="button" aria-expanded="false" aria-controls={`mega-${i}`} data-mega-trigger={i}>
            {item.label}
            <span class="caret" aria-hidden="true">▼</span>
          </button>
        ))
      }
    </nav>

    <a href="/proefles/" class="pill cta">Gratis proefles</a>
    <button class="menu-button" type="button" aria-haspopup="dialog" data-mobile-open>Menu</button>
  </div>

  {
    menu.map((item, i) => (
      <div class="mega" id={`mega-${i}`} hidden data-mega-panel={i}>
        <div class="mega-inner container">
          <div class="mega-groups">
            {item.groups.map((group) => (
              <div class="mega-group">
                <div class="mega-title">{group.title}</div>
                {group.links.map((link) => (
                  <a href={linkHref(link)}>{link}</a>
                ))}
              </div>
            ))}
          </div>
          <div class="promo">
            <div class="promo-title">{item.promoTitle}</div>
            <p class="promo-text">{item.promoText}</p>
            <a href={linkHref(item.promoCta)} class="pill promo-cta">{item.promoCta}</a>
          </div>
        </div>
      </div>
    ))
  }
</header>

<MobileMenu />

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: #fff;
    border-bottom: 1px solid var(--line);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 40px;
    min-height: 64px;
  }

  /* Rond logo-embleem dat onder de balk uitsteekt */
  .logo {
    --size: 136px;
    position: relative;
    z-index: 21;
    flex: none;
    width: var(--size);
    height: var(--size);
    margin: 14px 0 -42px;
    border-radius: 50%;
    background: #fff;
    border: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .logo-cover {
    position: absolute;
    left: -2px;
    right: -2px;
    top: -2px;
    height: 95px;
    background: #fff;
  }

  .logo img {
    position: relative;
    height: 104px;
    width: auto;
  }

  .nav {
    display: flex;
    gap: 30px;
    align-self: stretch;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 16px;
    font-weight: 500;
    color: var(--ink);
  }

  .nav-item[aria-expanded='true'] {
    color: var(--blue);
    box-shadow: inset 0 -3px 0 var(--blue);
  }

  .caret {
    font-size: 10px;
    opacity: 0.6;
  }

  .cta {
    margin-left: auto;
    font-size: 15px;
  }

  .menu-button {
    display: none;
  }

  .mega {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background: #fff;
    border-top: 1px solid #eceef2;
    box-shadow: 0 30px 50px rgba(17, 24, 39, 0.14);
  }

  .mega-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: 48px;
    padding-top: 62px;
    padding-bottom: 40px;
  }

  .mega-groups {
    display: flex;
    gap: 40px;
  }

  .mega-group {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }

  .mega-title {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .mega-group a {
    font-size: 17px;
    font-weight: 500;
    color: var(--ink);
  }

  .promo {
    background: var(--surface);
    border-radius: 16px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .promo-title {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 22px;
    color: var(--blue);
  }

  .promo-text {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
    color: var(--text);
  }

  .promo-cta {
    align-self: flex-start;
    margin-top: 6px;
    padding: 10px 18px;
    font-size: 15px;
  }

  @media (max-width: 959px) {
    .bar {
      justify-content: space-between;
      padding-top: 12px;
      padding-bottom: 12px;
    }

    .logo {
      --size: 92px;
      margin: 0 0 -36px;
    }

    .logo-cover {
      height: 69px;
    }

    .logo img {
      height: 70px;
    }

    .nav,
    .cta,
    .mega {
      display: none;
    }

    .menu-button {
      display: block;
      border: 1.5px solid var(--ink);
      border-radius: 999px;
      padding: 10px 16px;
      font-weight: 600;
      font-size: 15px;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const triggers = header.querySelectorAll<HTMLButtonElement>('[data-mega-trigger]');
  const panels = header.querySelectorAll<HTMLElement>('[data-mega-panel]');

  function openMega(index: number | null) {
    triggers.forEach((t, i) => t.setAttribute('aria-expanded', String(i === index)));
    panels.forEach((p, i) => (p.hidden = i !== index));
  }

  triggers.forEach((trigger, i) => {
    // Hover alleen met muis; touch gebruikt de klik
    trigger.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && openMega(i));
    trigger.addEventListener('click', () => openMega(trigger.getAttribute('aria-expanded') === 'true' ? null : i));
  });
  header.addEventListener('mouseleave', () => openMega(null));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && openMega(null));
</script>
