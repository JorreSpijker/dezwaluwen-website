---
import { getImage } from 'astro:assets';
import { ages, defaultAge, proeflesUrl } from '../data/memberwizard';
import { trainingSummary } from '../data/trainingstijden';

const photos = await Promise.all(
  ages.map(async (age) => ({
    alt: age.alt,
    desktop: await getImage({ src: age.desktop }),
    mobile: await getImage({ src: age.mobile }),
  })),
);
const current = ages[defaultAge];
---

<section class="hero" data-hero>
  <div class="intro">
    <p class="kicker">Korfbal voor iedereen.</p>
    <h1 class="title">Samen sporten begint hier.</h1>
    <p class="lead">
      Bij ons train je met vrienden, speel je elke zaterdag een wedstrijd en blijf je na afloop nog even hangen in de kantine.
    </p>

    <div class="picker">
      <div class="eyebrow" id="age-label">Hoe oud ben je?</div>
      <div class="ages" role="group" aria-labelledby="age-label">
        {
          ages.map((age, i) => (
            <button class="age" type="button" aria-pressed={String(i === defaultAge)} data-age={i}>
              {age.label}
            </button>
          ))
        }
      </div>
      <div class="age-info" aria-live="polite">
        <div>
          <div class="age-group" data-age-group>{current.group}</div>
          <div class="age-times" data-age-times>{trainingSummary(current.teams)}</div>
        </div>
        <a href={proeflesUrl(current)} class="pill age-cta" data-age-cta>Gratis proefles →</a>
      </div>
    </div>
  </div>

  <div class="photo">
    {
      photos.map((photo, i) => (
        <picture hidden={i !== defaultAge} data-age-photo={i}>
          <source media="(max-width: 959px)" srcset={photo.mobile.src} />
          <img
            src={photo.desktop.src}
            alt={photo.alt}
            loading={i === defaultAge ? 'eager' : 'lazy'}
            fetchpriority={i === defaultAge ? 'high' : 'auto'}
          />
        </picture>
      ))
    }
  </div>
</section>

<script define:vars={{ ages: ages.map((age) => ({ group: age.group, times: trainingSummary(age.teams), url: proeflesUrl(age) })) }}>
  const hero = document.querySelector('[data-hero]');
  const buttons = hero.querySelectorAll('[data-age]');
  const photos = hero.querySelectorAll('[data-age-photo]');

  buttons.forEach((button, i) =>
    button.addEventListener('click', () => {
      buttons.forEach((b, j) => b.setAttribute('aria-pressed', String(i === j)));
      photos.forEach((p, j) => (p.hidden = i !== j));
      hero.querySelector('[data-age-group]').textContent = ages[i].group;
      hero.querySelector('[data-age-times]').textContent = ages[i].times;
      hero.querySelector('[data-age-cta]').href = ages[i].url;
    }),
  );
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    /* Schermvullend onder de header (109px), begrensd voor lage en hoge schermen */
    min-height: clamp(620px, calc(100svh - 109px), 960px);
    position: relative;
    z-index: 2;
  }

  /* Tekst lijnt uit met de container, foto loopt door tot de schermrand */
  .intro {
    padding: 72px var(--gutter);
    padding-left: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
    display: flex;
    flex-direction: column;
    gap: 28px;
    justify-content: center;
  }

  .kicker {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    color: var(--blue);
  }

  .title {
    margin: 0;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: clamp(50px, 6.7vw, 86px);
    line-height: 0.9;
    letter-spacing: -0.02em;
    color: var(--blue);
  }

  .lead {
    margin: 0;
    font-size: 19px;
    line-height: 1.55;
    color: var(--text);
    max-width: 500px;
    text-wrap: pretty;
  }

  .picker {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ages {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .age {
    border: 2px solid var(--blue);
    color: var(--blue);
    font-weight: 700;
    padding: 12px 20px;
    border-radius: 999px;
  }

  .age {
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .age:not([aria-pressed='true']):hover {
    background: var(--blue-soft);
  }

  .age[aria-pressed='true'] {
    background: var(--blue);
    color: #fff;
  }

  .age-info {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 8px;
    padding: 18px 22px;
    background: var(--surface);
    border-radius: 14px;
  }

  .age-group {
    font-weight: 700;
  }

  .age-times {
    margin-top: 2px;
    font-size: 15px;
    color: var(--text-2);
  }

  .age-cta {
    margin-left: auto;
    flex: none;
    padding: 12px 20px;
  }

  .photo {
    position: relative;
    overflow: hidden;
    background: repeating-linear-gradient(135deg, #dbe3ee 0 12px, var(--placeholder) 12px 24px);
  }

  .photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: photo-in 0.5s ease;
  }

  /* Intro gestaffeld binnen, foto zacht erbij; ook bij wisselen van leeftijd */
  .intro > * {
    animation: fade-up 0.7s ease backwards;
  }

  .intro > :nth-child(2) {
    animation-delay: 0.08s;
  }

  .intro > :nth-child(3) {
    animation-delay: 0.16s;
  }

  .intro > :nth-child(4) {
    animation-delay: 0.24s;
  }

  @keyframes photo-in {
    from {
      opacity: 0;
      transform: scale(1.03);
    }
  }

  @media (max-width: 959px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .intro {
      padding: 28px 20px;
      padding-left: 20px;
      gap: 18px;
    }

    .kicker {
      display: none;
    }

    .lead {
      font-size: 17px;
      line-height: 1.5;
    }

    .eyebrow {
      font-size: 13px;
    }

    .ages {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 8px;
    }

    .age {
      height: 46px;
      padding: 0;
    }

    .age-info {
      margin-top: 6px;
      padding: 16px;
    }

    .age-cta {
      display: none;
    }

    .photo {
      height: 300px;
      margin: 0 20px;
      border-radius: 16px;
    }
  }
</style>
