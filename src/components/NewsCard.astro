---
import { Image } from 'astro:assets';
import { excerpt, formatDate, formatDateShort, newsUrl, type NewsEntry } from '../lib/news';

interface Props {
  item: NewsEntry;
  // Groot uitgelicht: blauwe kaart over de volle breedte van het raster
  featured?: boolean;
}

const { item, featured = false } = Astro.props;
---

{
  featured ? (
    <a href={newsUrl(item)} class="featured" data-category={item.data.category}>
      <div class="featured-photo">
        <Image src={item.data.image} alt="" loading="eager" />
      </div>
      <div class="featured-body">
        <span class="badge">Uitgelicht</span>
        <div class="featured-meta">
          {formatDate(item.data.date)} · {item.data.category}
        </div>
        <h3 class="featured-title">{item.data.title}</h3>
        <p class="featured-excerpt">{excerpt(item)}</p>
        <span class="featured-more">
          Lees verder <span aria-hidden="true">→</span>
        </span>
      </div>
    </a>
  ) : (
    <a href={newsUrl(item)} class="item" data-category={item.data.category}>
      <div class="photo">
        <Image src={item.data.image} alt="" />
      </div>
      <div class="meta">
        <span class="desktop">{formatDate(item.data.date)}</span>
        <span class="mobile">{formatDateShort(item.data.date)}</span> · {item.data.category}
      </div>
      <h3 class="title">
        <span class="desktop">{item.data.title}</span>
        <span class="mobile">{item.data.titleShort ?? item.data.title}</span>
      </h3>
    </a>
  )
}

<style>
  .item {
    display: flex;
    flex-direction: column;
    gap: 14px;
    color: var(--ink);
  }

  .item:hover {
    text-decoration: none;
  }

  .item:hover .title {
    color: var(--blue);
  }

  .photo {
    height: 170px;
    border-radius: 14px;
    overflow: hidden;
    background: var(--placeholder);
  }

  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .meta {
    font-size: 14px;
    color: var(--muted);
  }

  .title {
    margin: 0;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 20px;
    line-height: 1.2;
  }

  /* Uitgelicht bericht: blauwe kaart over volle breedte, foto links */
  .featured {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    min-height: 320px;
    border-radius: 20px;
    overflow: hidden;
    background: var(--blue);
    color: #fff;
    box-shadow: var(--card-shadow);
  }

  .featured:hover {
    color: #fff;
    text-decoration: none;
  }

  .featured-photo {
    position: relative;
    overflow: hidden;
    background: var(--blue-dark);
  }

  .featured-photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .featured:hover .featured-photo img {
    transform: scale(1.04);
  }

  .featured-body {
    padding: 32px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 12px;
  }

  .badge {
    padding: 5px 12px;
    border-radius: 999px;
    background: var(--orange);
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .featured-meta {
    font-size: 14px;
    font-weight: 500;
    color: var(--blue-muted);
  }

  .featured-title {
    margin: 0;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 30px;
    line-height: 1.08;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .featured-excerpt {
    margin: 0;
    font-size: 16px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.85);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .featured-more {
    margin-top: 6px;
    font-weight: 700;
  }

  .featured-more span {
    display: inline-block;
    color: var(--orange);
    transition: transform 0.2s ease;
  }

  .featured:hover .featured-more span {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .featured-photo img,
    .featured-more span {
      transition: none;
    }
  }

  .mobile {
    display: none;
  }

  @media (max-width: 959px) {
    .desktop {
      display: none;
    }

    .mobile {
      display: inline;
    }

    .item {
      display: grid;
      grid-template-columns: 96px 1fr;
      grid-template-rows: auto auto;
      column-gap: 14px;
      row-gap: 4px;
      align-content: center;
    }

    .photo {
      grid-row: span 2;
      height: 96px;
      border-radius: 12px;
    }

    .meta {
      align-self: end;
      font-size: 13px;
    }

    .title {
      align-self: start;
      font-size: 17px;
    }

    .featured {
      grid-template-columns: 1fr;
      min-height: 0;
      border-radius: 16px;
    }

    .featured-photo {
      height: 190px;
    }

    .featured-body {
      padding: 20px;
      gap: 10px;
    }

    .featured-title {
      font-size: 24px;
    }

    .featured-excerpt {
      font-size: 15px;
    }
  }
</style>
