---
interface Props {
  href?: string;
}

const { href = '/proefles/' } = Astro.props;
---

<div class="sticky">
  <a href={href} class="pill button">Plan je gratis proefles</a>
</div>

<style>
  .sticky {
    display: none;
  }

  @media (max-width: 959px) {
    .sticky {
      display: block;
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 15;
      padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
      background: #fff;
      border-top: 1px solid #eceef2;
    }

    .button {
      width: 100%;
      height: 52px;
      font-size: 17px;
    }
  }
</style>
