---
import Cms from '../../layouts/Cms.astro';
import { drafts, pending } from '../../lib/admin/repo';
import { sections } from '../../lib/admin/sections';

export const prerender = false;

const user = Astro.locals.user!;

// Alleen of er iets klaarstaat; de lijst en Publiceren staan op /cms/status
const waiting = drafts && (await pending()).files.length > 0;
---

<Cms title="Overzicht">
  <h1>Hoi {user.name}</h1>
  <p class="lead">
    {
      drafts
        ? 'Wat wil je aanpassen? Opgeslagen wijzigingen staan klaar op Status; met Publiceren zet je ze in één keer live.'
        : 'Wat wil je aanpassen? Opgeslagen wijzigingen staan na ongeveer een minuut op de site.'
    }
  </p>
  {
    waiting && (
      <a href="/cms/status" class="waiting">
        <span class="dot" aria-hidden="true" />
        Er staan wijzigingen klaar die nog niet live zijn. <b>Bekijken en publiceren →</b>
      </a>
    )
  }
  <div class="grid">
    {
      sections.map((s) => (
        <a href={s.href} class="tile">
          <span class="title">{s.title}</span>
          <span class="text">{s.text}</span>
        </a>
      ))
    }
  </div>
</Cms>

<style>
  h1 {
    margin: 0 0 8px;
    font-family: var(--font-head);
    color: var(--blue);
  }

  .waiting {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 28px;
    padding: 14px 18px;
    background: #fff;
    border: 2px solid var(--orange);
    border-radius: 14px;
    color: var(--ink);
  }

  .waiting:hover {
    text-decoration: none;
    border-color: var(--blue);
  }

  .waiting b {
    color: var(--blue);
  }

  .waiting .dot {
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--orange);
  }

  .lead {
    margin: 0 0 28px;
    color: var(--text-2);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
  }

  .tile {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 20px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 14px;
    color: var(--ink);
    transition: border-color 0.2s ease;
  }

  .tile:hover {
    text-decoration: none;
    border-color: var(--blue);
  }

  .title {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 18px;
    color: var(--blue);
  }

  .text {
    font-size: 14px;
    color: var(--text-2);
  }
</style>
