---
import OrganisatieEditor from '../../components/admin/OrganisatieEditor';
import Cms from '../../layouts/Cms.astro';
import { readFile } from '../../lib/admin/repo';

export const prerender = false;

const path = 'src/data/organisatie.json';
const file = await readFile(path);
---

<Cms title="Bestuur & commissies">
  <a href="/cms" class="back">← Overzicht</a>
  <h1>Bestuur & commissies</h1>
  <p class="intro">Wie zitten er in het bestuur en de commissies, wat doen ze en hoe bereik je ze.</p>
  <OrganisatieEditor client:load path={path} sha={file.sha} data={JSON.parse(file.content)} />
</Cms>

<style>
  .back {
    font-size: 14px;
    font-weight: 600;
  }

  h1 {
    margin: 8px 0;
    font-family: var(--font-head);
    color: var(--blue);
  }

  .intro {
    margin: 0 0 28px;
    color: var(--text-2);
    line-height: 1.5;
  }
</style>
