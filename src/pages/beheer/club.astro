---
import ClubEditor from '../../components/admin/ClubEditor';
import Beheer from '../../layouts/Beheer.astro';
import { readFile } from '../../lib/admin/repo';

export const prerender = false;

const path = 'src/data/club.json';
const file = await readFile(path);
---

<Beheer title="Teams & Sportlink">
  <a href="/beheer" class="back">← Overzicht</a>
  <h1>Teams & Sportlink</h1>
  <p class="intro">Teams op de site en hun codes in Sportlink. Programma, uitslagen en standen worden hiermee opgehaald.</p>
  <ClubEditor client:load path={path} sha={file.sha} data={JSON.parse(file.content)} />
</Beheer>

<style>
  .back {
    font-size: 14px;
    font-weight: 600;
  }

  h1 {
    margin: 8px 0;
    font-family: var(--font-head);
    color: var(--blue);
  }

  .intro {
    margin: 0 0 28px;
    color: var(--text-2);
    line-height: 1.5;
  }
</style>
