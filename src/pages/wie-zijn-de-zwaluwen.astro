---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import { linkHref, menu } from '../data/menu';
import { teams } from '../lib/matches';
import { veld } from '../data/trainingstijden';
import photo from '../assets/hero-desktop-3.webp';

const promo = menu[0];

// Alle teams uit het trainingsschema; competitieteams linken naar hun teampagina
const teamGroups = veld.groups.map((group) => ({
  title: group.title,
  teams: group.rows.map((row) => {
    const name = row.team.replace('*', '');
    const team = teams.find((t) => t.short === name);
    return { name, href: team && `/teams/${team.slug}/` };
  }),
}));
const teamCount = teamGroups.reduce((count, group) => count + group.teams.length, 0);

const facts = [
  { value: '1956', label: 'opgericht op 15 september' },
  { value: '± 160', label: 'leden, van kangoeroe tot senior' },
  { value: String(teamCount), label: 'teams, jeugd en senioren' },
  { value: '2', label: 'kunstgrasvelden op Sportpark Hengelder' },
];
---

<Base
  title="Wie zijn de Zwaluwen? — KV de Zwaluwen"
  description="KV de Zwaluwen is de korfbalvereniging van Zevenaar, sinds 1956. Maak kennis met onze teams, ons sportpark en onze geschiedenis."
>
  <Header />
  <main class="page container">
    <header class="intro">
      <nav class="crumbs" aria-label="Kruimelpad">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span>Nieuw lid?</span>
      </nav>
      <h1 class="title">Wie zijn de Zwaluwen?</h1>
      <p class="lead">
        KV de Zwaluwen is de korfbalvereniging van Zevenaar. Al sinds 1956 trainen en spelen we op Sportpark Hengelder, met teams voor iedereen vanaf vier jaar, van jeugd tot senioren en recreanten.
      </p>
    </header>

    <div class="photo">
      <Image src={photo} alt="Senioren van KV de Zwaluwen in actie tijdens een wedstrijd" widths={[640, 1280]} sizes="(max-width: 959px) 100vw, 1168px" loading="eager" />
    </div>

    <section class="facts" aria-label="De Zwaluwen in cijfers">
      {
        facts.map((fact) => (
          <div class="fact">
            <span class="fact-value">{fact.value}</span>
            <span class="fact-label">{fact.label}</span>
          </div>
        ))
      }
    </section>

    <div class="layout">
      <article class="prose">
        <h2>Een club voor iedereen</h2>
        <p>
          Bij de Zwaluwen speel je in een gemengd team, met vrienden en klasgenoten. Op zaterdag spelen de meeste teams hun wedstrijd, de midweekploeg speelt op woensdagavond. Na afloop blijven we graag nog even hangen in de kantine.
        </p>

        <h3>Onze teams</h3>
        {
          teamGroups.map((group) => (
            <div class="team-group">
              <span class="team-group-title">{group.title}</span>
              <ul class="chips">
                {group.teams.map((team) => (
                  <li>{team.href ? <a href={team.href} class="chip chip-link">{team.name}</a> : <span class="chip">{team.name}</span>}</li>
                ))}
              </ul>
            </div>
          ))
        }

        <h2>Waar we spelen</h2>
        <p>
          Sinds 1966 is Sportpark Hengelder aan de Marconistraat in Zevenaar ons thuis. In 1981 werd daar ons clubgebouw met kantine geopend. Sinds 2012 spelen we op twee kunstgrasvelden, en sinds 2018 ligt er een beachveld dat we delen met volleybalclub Labyellov en handbalvereniging OBW.
        </p>
        <p>
          In het zaalseizoen trainen en spelen we bij Heerenmäten en De Cluse. Wanneer jouw team traint, zie je bij de <a href="/trainingstijden/">trainingstijden</a>.
        </p>

        <h2>Een club van vrijwilligers</h2>
        <p>
          Trainers, coaches, scheidsrechters, de kantine, het bestuur en de commissies: alles bij de Zwaluwen draait op vrijwilligers. Ook ouders helpen mee, bijvoorbeeld met rijden naar uitwedstrijden. Zo houden we de club samen draaiende, en een uurtje per maand helpt al.
        </p>

        <h2>Onze geschiedenis</h2>
        <p>
          De Zwaluwen heeft twee keer bestaan. Rond 1940 stapte gymnastiekvereniging Jonge Kracht over op korfbal, en zo ontstond de eerste KV de Zwaluwen. De naam en het blauwe shirt met oranje bies kwamen uit de oorlogstijd: de club wilde zo vrij zijn als een vogel. In 1952 hield die vereniging op te bestaan.
        </p>
        <p>
          Op 15 september 1956 werd KV de Zwaluwen opnieuw opgericht, en vanaf 1966 speelt de club op Sportpark Hengelder. Sindsdien is de vereniging gegroeid tot zo'n 160 leden.
        </p>
      </article>

      <aside class="promo" aria-label="Gratis proefles">
        <div class="promo-title">{promo.promoTitle}</div>
        <p class="promo-text">{promo.promoText}</p>
        <a href={linkHref(promo.promoCta)} class="pill promo-cta">{promo.promoCta}</a>
      </aside>
    </div>
  </main>
  <Footer />
  <StickyCta />
</Base>

<style>
  .page {
    padding-top: 88px;
    padding-bottom: 96px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 820px;
  }

  .crumbs {
    display: flex;
    gap: 8px;
    font-size: 15px;
    font-weight: 600;
    color: var(--faint);
  }

  .title {
    margin: 0;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: clamp(40px, 5.5vw, 72px);
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--blue);
  }

  .lead {
    margin: 0;
    font-size: 21px;
    line-height: 1.55;
    color: var(--ink);
  }

  .photo {
    aspect-ratio: 21 / 9;
    border-radius: 20px;
    overflow: hidden;
    background: var(--placeholder);
  }

  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .fact {
    background: var(--blue);
    color: #fff;
    border-radius: 16px;
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .fact-value {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 40px;
    line-height: 1;
  }

  .fact-label {
    font-size: 15px;
    line-height: 1.4;
    color: var(--blue-muted);
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 720px) 340px;
    justify-content: space-between;
    gap: 48px;
    padding-top: 16px;
  }

  .prose {
    font-size: 18px;
    line-height: 1.65;
    color: var(--text);
  }

  .prose h2 {
    margin: 44px 0 12px;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 30px;
    line-height: 1.15;
    color: var(--ink);
  }

  .prose h2:first-child {
    margin-top: 0;
  }

  .prose h3 {
    margin: 28px 0 12px;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 20px;
    color: var(--ink);
  }

  .prose p {
    margin: 0 0 18px;
  }

  .team-group {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 12px;
    align-items: start;
    padding: 12px 0;
    border-top: 1px solid var(--line-soft);
  }

  .team-group-title {
    padding-top: 6px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .chips {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chip {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--surface);
    font-size: 15px;
    font-weight: 600;
    color: var(--ink);
  }

  .chip-link {
    background: var(--blue-soft);
    color: var(--blue);
  }

  .chip-link:hover {
    background: var(--blue-muted);
    text-decoration: none;
  }

  .promo {
    align-self: start;
    position: sticky;
    top: 133px;
    background: var(--surface);
    border-radius: 16px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .promo-title {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 22px;
    color: var(--blue);
  }

  .promo-text {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
    color: var(--text);
  }

  .promo-cta {
    align-self: flex-start;
    margin-top: 6px;
    padding: 10px 18px;
    font-size: 15px;
  }

  @media (max-width: 959px) {
    :global(body) {
      padding-bottom: calc(76px + env(safe-area-inset-bottom));
    }

    .page {
      padding-top: 56px;
      padding-bottom: 48px;
      gap: 28px;
    }

    .lead {
      font-size: 18px;
    }

    .photo {
      aspect-ratio: 4 / 3;
      border-radius: 16px;
    }

    .facts {
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }

    .fact {
      padding: 16px;
    }

    .fact-value {
      font-size: 32px;
    }

    .fact-label {
      font-size: 14px;
    }

    .layout {
      grid-template-columns: 1fr;
      gap: 32px;
      padding-top: 0;
    }

    .prose {
      font-size: 17px;
    }

    .prose h2 {
      margin-top: 36px;
      font-size: 24px;
    }

    .team-group {
      grid-template-columns: 1fr;
      gap: 6px;
    }

    .promo {
      position: static;
    }
  }
</style>
