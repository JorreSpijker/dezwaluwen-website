# Instellingen voor /beheer. Kopieer naar .env (lokaal) of zet in Vercel (Project → Settings → Environment Variables).

# Willekeurige lange string voor het tekenen van sessies, bv. `openssl rand -base64 32`
AUTH_SECRET=
# Komma-gescheiden Google-adressen die toegang hebben tot /beheer
BEHEER_EMAILS=
# Google OAuth-client (Google Cloud → APIs & Services → Credentials → OAuth client ID, type Web application).
# Redirect-URI's: http://localhost:4321/api/beheer/google/callback en https://<domein>/api/beheer/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Fine-grained token: alleen deze repo, Contents read/write + Deployments read (voor de deploystatus).
# Lokaal leeg = lezen en schrijven in de werkmap, zonder commits
GITHUB_TOKEN=
# Regel weglaten = standaard (JorreSpijker/dezwaluwen-website, main); niet leeg laten.
# Lokaal testen met commits: een testbranch die op GitHub bestaat
# GITHUB_REPO=JorreSpijker/dezwaluwen-website
# GITHUB_BRANCH=main
